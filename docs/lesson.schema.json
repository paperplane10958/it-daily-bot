{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://it-daily-bot.local/schemas/lesson-v1.json",
  "title": "Lesson v1",
  "description": "Урок IT Daily Bot: теория, примеры, машино-проверяемый квиз. См. docs/lesson-schema.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "roadmap",
    "language",
    "difficulty",
    "est_minutes",
    "xp",
    "status",
    "title",
    "hook",
    "theory",
    "quiz",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmap_id", "node", "category", "order"],
      "properties": {
        "roadmap_id": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "language": { "type": "string", "minLength": 2, "maxLength": 2 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "est_minutes": { "type": "integer", "minimum": 3, "maximum": 30 },
    "xp": { "type": "integer", "minimum": 5, "maximum": 100 },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "published", "archived"]
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "hook": { "type": "string", "minLength": 10, "maxLength": 400 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 5, "maxLength": 200 }
    },
    "theory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "body"],
        "properties": {
          "heading": { "type": "string", "minLength": 2, "maxLength": 100 },
          "body": { "type": "string", "minLength": 40, "maxLength": 2500 }
        }
      }
    },
    "key_terms": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string", "minLength": 1, "maxLength": 60 },
          "definition": { "type": "string", "minLength": 5, "maxLength": 300 }
        }
      }
    },
    "examples": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 100 },
          "body": { "type": "string", "minLength": 20, "maxLength": 2000 },
          "code": { "type": "string", "maxLength": 1500 }
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "solution"],
      "properties": {
        "prompt": { "type": "string", "minLength": 10, "maxLength": 500 },
        "hint": { "type": "string", "maxLength": 300 },
        "solution": { "type": "string", "minLength": 5, "maxLength": 1000 }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "question", "options", "correct", "explanation"],
        "properties": {
          "kind": { "type": "string", "enum": ["single", "multi"] },
          "question": { "type": "string", "minLength": 5, "maxLength": 300 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "correct": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "integer", "minimum": 0, "maximum": 5 }
          },
          "explanation": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    },
    "pitfalls": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 10, "maxLength": 300 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "model", "prompt_version"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "model": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}