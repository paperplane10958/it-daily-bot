# Токен бота от @BotFather
BOT_TOKEN=

# SOCKS/HTTP-прокси для Telegram (если api.telegram.org недоступен напрямую)
BOT_PROXY=socks5://localhost:1080

# Ключ OpenRouter для контент-агента (пока не используется, на будущее)
OPENROUTER_API_KEY=

# Модель генерации уроков через OpenRouter
LLM_MODEL=anthropic/claude-3.5-haiku