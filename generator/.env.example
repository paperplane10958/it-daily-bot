# Ключ OpenRouter для генерации уроков
OPENROUTER_API_KEY=

# Модель генерации уроков
LLM_MODEL=anthropic/claude-haiku-5.5

# Прокси для OpenRouter берётся из системной переменной ALL_PROXY (не из этого файла):
# OpenRouter блокирует python-urllib по TLS-отпечатку — клиент на httpx, прокси подхватывает из env.